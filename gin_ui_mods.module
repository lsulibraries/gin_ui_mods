<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\user\Entity\User;

/**
 * @file
 * Gin UI Mods module.
 */

/**
 * Implements hook_page_attachments().
 */
function gin_ui_mods_page_attachments(array &$attachments): void
{
  $admin_context = \Drupal::service('router.admin_context');
  $current_user = \Drupal::currentUser();
  $config = \Drupal::config('system.theme');

  $admin_theme = (string) $config->get('admin');
  $is_admin_route = $admin_context->isAdminRoute();
  $is_gin_context = $admin_theme === 'gin' && $current_user->isAuthenticated();

  if ($is_admin_route || $is_gin_context) {
    $attachments['#attached']['library'][] = 'gin_ui_mods/sidebar_default_open';
    $attachments['#attached']['library'][] = 'gin_ui_mods/gin_admin';
    $attachments['#attached']['library'][] = 'gin_ui_mods/user_menu_labels';
    $attachments['#attached']['library'][] = 'gin_ui_mods/sidebar_theme_toggle';
    $attachments['#attached']['library'][] = 'gin_ui_mods/flag_review_icon';

    // Temporary debug: expose likely Gin user preference storage to JS console.
    $uid = (int) $current_user->id();
    $user = User::load($uid);
    $user_data = \Drupal::service('user.data');
    $gin_data = $user_data->get('gin', $uid);

    $attachments['#attached']['drupalSettings']['ginUiModsDebugStorage'] = [
      'uid' => $uid,
      'admin_theme' => $admin_theme,
      'is_admin_route' => $is_admin_route,
      'is_gin_context' => $is_gin_context,
      'user_data_gin' => $gin_data,
      'user_data_gin_keys' => is_array($gin_data) ? array_keys($gin_data) : [],
      'user_data_gin_toolbar' => $user_data->get('gin_toolbar', $uid),
      'user_entity_keys' => $user ? array_keys($user->toArray()) : [],
    ];
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for the user login form.
 */
function gin_ui_mods_form_user_login_form_alter(array &$form, FormStateInterface $form_state, $form_id): void
{
  // Ensure the more-links container exists (gin_login creates this, but be safe).
  if (!isset($form['more-links'])) {
    $form['more-links'] = [
      '#type' => 'container',
      '#weight' => 99,
      '#attributes' => ['class' => ['more-links']],
    ];
  }

  // myLSU link.
  $form['more-links']['gin_ui_mods_mylsu_link'] = [
    '#type' => 'link',
    '#title' => t('myLSU'),
    '#url' => Url::fromUri('https://my.lsu.edu/'),
    '#attributes' => [
      'class' => ['link', 'link--more', 'gin-ui-mods-mylsu-link'],
      'target' => '_blank',
      'rel' => 'noopener noreferrer',
    ],
    '#weight' => 10,
  ];

  // Springshare link.
  $form['more-links']['gin_ui_mods_back_link'] = [
    '#type' => 'link',
    '#title' => t('Springshare'),
    '#url' => Url::fromUri('https://lsu.libapps.com/libapps/login.php'),
    '#attributes' => [
      'class' => ['link', 'link--more', 'gin-ui-mods-mylsu-link'],
      'target' => '_blank',
      'rel' => 'noopener noreferrer',
    ],
    '#weight' => 11,
  ];

    // Springshare link.
  $form['more-links']['gin_ui_mods_Sharepoint_link'] = [
    '#type' => 'link',
    '#title' => t('Sharepoint'),
    '#url' => Url::fromUri('https://lsumail2.sharepoint.com/sites/Team-LIB/SitePages/Home6.aspx'),
    '#attributes' => [
      'class' => ['link', 'link--more', 'gin-ui-mods-mylsu-link'],
      'target' => '_blank',
      'rel' => 'noopener noreferrer',
    ],
    '#weight' => 11,
  ];


  // Optionally attach a login-specific library for CSS.
  $form['#attached']['library'][] = 'gin_ui_mods/login';
  $form['#submit'][] = 'gin_ui_mods_user_login_form_submit';
}

/**
 * Custom submit handler for login redirect.
 */
function gin_ui_mods_user_login_form_submit(array &$form, FormStateInterface $form_state): void
{
  $request = \Drupal::request();
  $destination = $request->query->get('destination') ?: $request->request->get('destination');

  if (empty($destination)) {
    $form_state->setRedirectUrl(Url::fromUserInput('/admin/mycontent'));
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for the user edit form.
 */
function gin_ui_mods_form_user_form_alter(array &$form, FormStateInterface $form_state, $form_id): void
{
  $form['#after_build'][] = 'gin_ui_mods_user_form_after_build';
}

/**
 * Final user form cleanup after Gin adds its settings.
 */
function gin_ui_mods_user_form_after_build(array $form, FormStateInterface $form_state): array
{
  if (!isset($form['gin_theme_settings'])) {
    return $form;
  }

  // Turn on per-user Gin overrides by default.
  if (isset($form['gin_theme_settings']['enable_user_settings'])) {
    $form['gin_theme_settings']['enable_user_settings']['#default_value'] = 1;
    $form['gin_theme_settings']['enable_user_settings']['#value'] = 1;
  }

  // Keep only the options you want in Gin per-user settings.
  if (isset($form['gin_theme_settings']['user_settings'])) {
    $allowed = [
      'enable_darkmode',
      'preset_accent_color',
      'accent_group',
    ];

    foreach (array_keys($form['gin_theme_settings']['user_settings']) as $key) {
      if (strpos((string) $key, '#') === 0) {
        continue;
      }

      if (!in_array($key, $allowed, TRUE)) {
        unset($form['gin_theme_settings']['user_settings'][$key]);
      }
    }
  }
  return $form;
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node forms.
 *
 * Adds staff profile best practices message on staff node add/edit.
 */
function gin_ui_mods_form_node_form_alter(array &$form, FormStateInterface $form_state, $form_id): void
{
  $node = $form_state->getFormObject()->getEntity();

  if ($node->bundle() !== 'staff') {
    return;
  }

  if (!\Drupal::currentUser()->isAuthenticated()) {
    return;
  }

  $message = t('
    <strong>Staff Profile Page Best Practices</strong><br>
    <ul>
      <li><strong>Required:</strong> job title, department/unit, brief description of responsibilities, and contact methods (LSU phone/email).</li>
      <li>Optional: education, research interests, and publications (include DOIs where available).</li>
      <li>Use a professional headshot (contact LSU Libraries’ comms team to schedule a photo if needed).</li>
      <li>Use only official LSU email and department affiliation.</li>
      <li>No personal contact details (personal phone numbers, home address, personal email).</li>
      <li>Keep all content professional and job-related.</li>
      <li>Do not list personal social media or personal websites.</li>
      <li>External links must be professional and job-related (for example, publications or official profiles) and should meet LSU accessibility standards.</li>
    </ul>
  ');

  \Drupal::messenger()->addWarning($message);
}
